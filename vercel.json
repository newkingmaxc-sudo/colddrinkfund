  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.2",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(admin/app-assets/.*|admin/assets/.*|assets/.*|asset/.*|css/.*|js/.*|static/.*|upload/.*|uploads/.*|img/.*|images/.*|common/.*|icon/.*|gifimg/.*|pimg/.*|bgimg/.*|v1/.*|v2/.*|mui/.*|site/.*|toastr/.*|build/.*|h5/.*|lottery/.*|favicon.ico|robots.txt)",
      "dest": "/public/$1"
    },
    {
      "src": "/([^/]+\\.(png|jpg|jpeg|gif|svg|ico|webp|css|js|woff|woff2|ttf|eot))$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
